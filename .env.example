# Supabase — project URL and the browser-safe publishable key.
# Both are public by design; they are the pair @supabase/ssr needs on the client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Bypasses RLS entirely — never import this from anything that
# reaches the browser, and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Session-mode Postgres connection (port 5432, NOT the 6543 pooler) as the
# pipeline's role: `aenima_pipeline`, a member of `service_role`, which reads
# and writes every row and cannot create, alter or own anything. Used by the
# dev server, the seed, every db test, and every `/ticket` run, human or
# scheduled. Server-only. The role is created once per project by the SQL in
# docs/guidelines.md §5.
DATABASE_URL=postgresql://aenima_pipeline.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres

# The admin connection lives in a second file, `.env.migrate`, holding one line:
#
#   DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres
#
# Only `pnpm db:migrate` and `pnpm db:baseline` read it. It is gitignored like
# every .env file, and `.worktreeinclude` does not carry it, so a worktree has
# no admin URL at all — applying a migration is a human step, in the primary
# checkout. docs/guidelines.md §5.

# Development only, and optional. Adds this account to the seed workspace as an
# Owner when `pnpm db:seed` runs, so you can see the seeded data signed in as
# yourself instead of landing in an empty workspace of your own. Ignored under
# NODE_ENV=production, ignored when the address has no account, and it can only
# ever touch the workspace the seed itself created. See docs/schema.md.
DEV_SEED_EMAIL=

# Development only, and optional. Puts a real AI key on the seed workspace when
# `pnpm db:seed` runs, through the same code path an Owner's settings screen
# uses — the secret goes to Supabase Vault, never into a column. Anthropic wins
# when both are set: §12 has one provider active at a time. Ignored under
# NODE_ENV=production, and it can only ever touch the workspace the seed itself
# created. See docs/build-log.md.
DEV_ANTHROPIC_API_KEY=
DEV_OPENAI_API_KEY=
