# Supabase — project URL and the browser-safe publishable key.
# Both are public by design; they are the pair @supabase/ssr needs on the client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Bypasses RLS entirely — never import this from anything that
# reaches the browser, and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Direct/session-mode Postgres connection (port 5432, NOT the 6543 pooler).
# Used by drizzle-kit and by the seed and RLS tests. Server-only.
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres

# Development only, and optional. Adds this account to the seed workspace as an
# Owner when `pnpm db:seed` runs, so you can see the seeded data signed in as
# yourself instead of landing in an empty workspace of your own. Ignored under
# NODE_ENV=production, ignored when the address has no account, and it can only
# ever touch the workspace the seed itself created. See docs/schema.md.
DEV_SEED_EMAIL=
